@startuml
title WarmHouse Web Application Component Diagram

top to bottom direction

!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml

Container_Boundary(WarmHouseSystem, "WarmHouse System") {
  Container(SystemEngine, "SystemEngine", "Manage controllers")
  Container(Database, "Database", "PostgreSQL", "Stores data")
  Container(WebUI, "Web UI")
}

Container(SystemEngine, "System Engine") {
  Component(AdminsAPI, "AdminsAPI", "API for Administrators")
  Component(UImanager, "UImanager", "User's data")
  Component(ControllerManager, "ControllerManager", "Manages controllers")
  Component(ServiceLayer, "Service Layer", "Business logic")
  Component(RepositoryLayer, "Repository Layer", "Data access logic")
}
Person(admin, "Administrator", "An administrator managing the system")
System_Ext(controllers, "Controllers", "Switching on/off heaters, get actual temp")

Rel(admin,AdminsAPI, "Get/Write Data")
Rel(ControllerManager,controllers,"Get/Write Data")
Rel(WebUI,UImanager,"Get/Write data")
Rel(AdminsAPI,ServiceLayer,"Calls business logic")
Rel(UImanager,ServiceLayer,"Calls business logic")
Rel(ControllerManager,ServiceLayer,"Calls business logic")
Rel(ServiceLayer,RepositoryLayer,"Reads/Writes data")
Rel(RepositoryLayer,Database,"Reads/Writes user data")
@enduml